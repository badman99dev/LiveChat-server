# copy to .env  ->  cp deploy/.env.example .env
PORT=8080
HOST=127.0.0.1

# openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# true when served over HTTPS behind nginx
COOKIE_SECURE=true

# optional: POST /api/score needs  x-admin-token: <ADMIN_TOKEN>
# leave empty to disable the endpoint entirely
ADMIN_TOKEN=

# mock cricket feed; set MOCK_SCORE=false when pushing real scores
MOCK_SCORE=true
MOCK_SCORE_MS=7000

CHAT_MAX_LEN=500
RATE_MS=1000
REPLAY_LIMIT=100

DATA_DIR=/opt/live-chat/data
