# copy to .env  ->  cp deploy/.env.example .env
PORT=8080
HOST=127.0.0.1

# openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Room Access Keys (see PROTOCOL.md). SHARED with the key-issuer server.
# 64-char hex recommended: openssl rand -hex 32
# Leave empty to disable ?key= room links entirely.
# Keys may embed an optional openAt/closeAt room window - no env needed for that.
ROOM_KEY_SECRET=

# Optional: a public room used when no ?key= is supplied (handy for dev/demo).
# Set empty in production to force key-based rooms only.
DEFAULT_ROOM=
DEFAULT_ROOM_NAME=Public chat

# true when served over HTTPS behind nginx
COOKIE_SECURE=true

# optional: POST /api/score needs  x-admin-token: <ADMIN_TOKEN>
# leave empty to disable the endpoint entirely
ADMIN_TOKEN=

# mock cricket feed; set MOCK_SCORE=false when pushing real scores
MOCK_SCORE=true
MOCK_SCORE_MS=7000

CHAT_MAX_LEN=500
RATE_MS=1000
REPLAY_LIMIT=100

# Retention: messages older than this are deleted (default 10 minutes).
RETENTION_MINUTES=10
# Close a room (drop it + its messages) after this many minutes with no
# activity. A still-valid key lazily reopens it. 0 disables idle closing.
ROOM_IDLE_MINUTES=30
# How often the sweeper runs (ms).
PRUNE_INTERVAL_MS=30000

DATA_DIR=/opt/live-chat/data
